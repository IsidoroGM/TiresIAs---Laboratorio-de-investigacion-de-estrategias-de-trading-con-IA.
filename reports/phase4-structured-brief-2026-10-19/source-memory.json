      "proposal": {
        "title": "Tendencia SMA/EMA BCE",
        "hypothesis": "Entrar solo si EMA > SMA y cerrar al siguiente cruce inverso.",
        "entry_rule": "Abrir largo cuando EMA supera SMA en la observación actual.",
        "exit_rule": "Cerrar posición al siguiente cruce inverso detectado.",
        "parameters": [
          {
            "name": "reference_series",
            "value": 1
